# News4Littles web configuration.
#
#   cp .env.example .env
#
# .env is gitignored; this file is the committed template. Vite only exposes
# variables prefixed with VITE_ to browser code.

# Base URL of the News4Littles API (the /server app).
# No trailing slash. Must match the port the server listens on, and this
# origin must appear in the server's CORS_ORIGIN.
VITE_API_BASE_URL=http://localhost:4000
