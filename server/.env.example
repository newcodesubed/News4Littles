# News4Littles server configuration.
#
#   cp .env.example .env
#
# .env is gitignored; this file is the committed template. Every variable is
# optional — the defaults below are what the server uses if .env is absent.
# A real shell variable overrides the file:  PORT=5000 npm run dev

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on.
PORT=4000

# Comma-separated origins allowed to call the API.
# The default is the Vite dev server; add your LAN address here if you test
# from a phone, e.g. http://192.168.1.20:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite file. A relative path resolves against /server, not your shell's cwd.
DATABASE_PATH=data/news4littles.db

# ---------------------------------------------------------------------------
# Admin account (PRD §4.1)
# ---------------------------------------------------------------------------

# Read by the seed script when it creates the admin row. Only the bcrypt hash
# is stored — the plaintext never reaches the database.
# Changing these does NOT update an existing account: delete the row from
# admin_users and re-run `npm run db:seed`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# Scheduled scraping (PRD §5.3)
# ---------------------------------------------------------------------------

# The scrape TIMES live in the database (app_settings.scrapeTimes, seeded to
# ["06:00"]) so editors can change them from admin settings. These two are
# deployment concerns the PRD does not cover.

# Set to false to stop the server registering cron jobs at all — handy in dev.
SCRAPE_ENABLED=true

# Which timezone "06:00" means. Defaults to the server's own zone.
# SCRAPE_TIMEZONE=Asia/Kathmandu

# ---------------------------------------------------------------------------
# LLM simplification (PRD §9.1, §13.2)
# ---------------------------------------------------------------------------

# OpenRouter API key. This is the ONLY place a key belongs: never in the
# database, never in seed data, never committed. With no key set, the local
# rule-based fallback (§9.2) runs and nothing is charged.
OPENROUTER_KEY=

# Set to false to force the free local fallback even when a key is present.
LLM_ENABLED=true

# Any OpenRouter model id. The default is chosen for cost: roughly $0.0002 per
# article, so a full 35-item scrape costs well under a penny.
LLM_MODEL=google/gemini-2.5-flash-lite

# --- cost guards. Lower these to spend less; raise them for longer articles ---

# Caps the priced half of each response.
LLM_MAX_TOKENS=1500

# Article text is truncated to this many characters before being sent, so one
# huge paste cannot run up a bill.
LLM_MAX_BODY_CHARS=6000

LLM_TIMEOUT_MS=30000

# Retries apply only to transient failures (429, 5xx).
LLM_MAX_RETRIES=1

# Auto mode: let an LLM judge freshly simplified stories and publish the ones it
# approves, with NO editor involved. Off by default, unlike the flags above,
# because it trades away the human review this product otherwise promises.
# Needs a working OPENROUTER_KEY: no judge means nothing is auto-published.
# Anything the judge does not explicitly approve stays in pending_review.
AUTO_APPROVE_ENABLED=false

# ---------------------------------------------------------------------------
# Text-to-speech (PRD §3.5)
# ---------------------------------------------------------------------------

# WHICH provider speaks. This names a module in src/tts, and it is the only
# thing that has to change to switch voice provider: add a file implementing
# SpeechProvider, register it in src/tts/index.ts, put its id here. No route,
# service or frontend code knows the difference.
TTS_PROVIDER=openrouter

# Set to false to turn the player off entirely. Nothing is synthesised and
# nothing is charged; the podcast page simply shows no play button.
TTS_ENABLED=true

# Model and voice, in whatever vocabulary the provider above uses. These
# defaults are OpenRouter's, and the voice id MUST match the model — Azure
# names for mai-voice-2, 'Eve' for grok-voice-tts, 'en_paul_neutral' for
# voxtral. A mismatch comes back as a 400 from the provider.
#
# NOTE: OpenRouter does NOT serve openai/gpt-4o-mini-tts; its /audio/speech
# endpoint answers "Model openai/gpt-4o-mini-tts does not exist".
TTS_MODEL=microsoft/mai-voice-2
TTS_VOICE=en-US-AvaNeural

# The OpenRouter provider reuses OPENROUTER_KEY above — same account, same
# bill. A different provider would read its own key variable, declared next to
# its own module in src/env.ts.

# Synthesis takes real seconds for a long script, unlike a chat completion.
TTS_TIMEOUT_MS=60000

# Retries apply only to transient failures (429, 5xx).
TTS_MAX_RETRIES=1

# Scripts are truncated to this many characters before being sent. TTS is
# billed by input length, so this is the cost guard.
TTS_MAX_CHARS=2000

# Where synthesised audio is cached, relative to /server. A story is paid for
# once, not once per listener. Safe to delete at any time: the cache key is a
# hash of the script, model and voice, so it refills itself and an edited
# script never serves the old audio.
AUDIO_CACHE_DIR=data/audio
