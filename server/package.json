{
  "name": "news4littles-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts",
    "seed": "tsx src/db/seed-articles.ts",
    "typecheck": "tsc --noEmit",
    "pipeline:demo": "tsx scripts/try-pipeline.ts",
    "try:rss": "tsx scripts/try-rss.ts",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:bbc": "tsx scripts/scrape.ts --source bbc",
    "test": "vitest run",
    "test:watch": "vitest",
    "llm:check": "tsx scripts/check-llm.ts",
    "db:update-prompts": "tsx scripts/update-seeded-prompts.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
